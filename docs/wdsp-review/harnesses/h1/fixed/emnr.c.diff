+/* ===== proposed-fix knobs (harness) ===== */
+int fix_cep = 0;          /* (a) cepstral smoothing of the gain (Breithaupt/Gerkmann/Martin 2007) */
+int fix_soft3 = 0;        /* (b) sigmoid soft zeta mask in method 3 */
+int fix_ximin = 0;        /* (c) xi_min = -20 dB for methods 0/1/3 (adds floor to method 1) */
+double fix_soft_s = 0.5;  /* sigmoid slope (zeta units) */
+double fix_soft_gmin = 0.1; /* G_min for soft mask (-20 dB) */
+typedef struct { int n; double *logg, *cep, *lam, *alpha, *cy; fftw_plan fwd, inv, ycep; double *ly; double *lyc; int init; double scale, a_hi, a_pitch, beta; int qlow, pw, qpmin, qpmax; } cepst;
+static cepst cs;
+static void cep_setup(EMNR a)
+{
+	int n = a->fsize;
+	if (cs.n == n) return;
+	cs.n = n;
+	cs.logg = (double*)fftw_malloc(n * sizeof(double));
+	cs.cep  = (double*)fftw_malloc(n * sizeof(double));
+	cs.cy   = (double*)fftw_malloc((n/2+1) * 2 * sizeof(double));
+	cs.ly   = (double*)fftw_malloc(n * sizeof(double));
+	cs.lyc  = (double*)fftw_malloc(n * sizeof(double));
+	cs.lam  = (double*)calloc(n/2+1, sizeof(double));
+	cs.alpha= (double*)calloc(n/2+1, sizeof(double));
+	/* even real sequences: use REDFT00 (DCT-I) of length n/2+1, which is the real FFT of the symmetric extension */
+	cs.fwd  = fftw_plan_r2r_1d(n/2+1, cs.logg, cs.cep, FFTW_REDFT00, FFTW_ESTIMATE);
+	cs.inv  = fftw_plan_r2r_1d(n/2+1, cs.cep, cs.logg, FFTW_REDFT00, FFTW_ESTIMATE);
+	cs.ycep = fftw_plan_r2r_1d(n/2+1, cs.ly, cs.lyc, FFTW_REDFT00, FFTW_ESTIMATE);
+	/* paper constants at fs=8 kHz, hop 128 (16 ms): alpha 0 for q<3, 0.2..0.4 at pitch, 0.97 else, beta 0.96.
+	   Quefrency scaled by fs/8000; time constants rescaled to this hop. */
+	cs.scale = a->rate / 8000.0;
+	{
+		double r = (a->incr / a->rate) / 0.016;
+		cs.a_hi = pow(0.97, r);
+		cs.a_pitch = pow(0.4, r);
+		cs.beta = pow(0.96, r);
+	}
+	cs.qlow = (int)(3.0 * cs.scale + 0.5);
+	cs.pw = (int)(1.0 * cs.scale + 0.5);
+	cs.qpmin = (int)(a->rate / 400.0);
+	cs.qpmax = (int)(a->rate / 70.0);
+	cs.init = 0;
 }
+static void cep_smooth(EMNR a)
+{
+	int k, q, m = a->msize, n = a->fsize;
+	cep_setup(a);
+	/* cepstrum of log gain */
+	for (k = 0; k < m; k++) cs.logg[k] = log(max(a->mask[k], 1.0e-6));
+	fftw_execute(cs.fwd);
+	/* pitch from cepstrum of noisy log power */
+	for (k = 0; k < m; k++) cs.ly[k] = log(a->g.lambda_y[k] + 1.0e-300);
+	fftw_execute(cs.ycep);
+	int qp = cs.qpmin; double best = -1e300;
+	for (q = cs.qpmin; q <= cs.qpmax && q < m; q++) if (cs.lyc[q] > best) { best = cs.lyc[q]; qp = q; }
+	for (q = 0; q < m; q++)
+	{
+		double ac;
+		if (q < cs.qlow) ac = 0.0;
+		else if (q >= qp - cs.pw && q <= qp + cs.pw) ac = cs.a_pitch;
+		else ac = cs.a_hi;
+		if (!cs.init) cs.alpha[q] = ac;
+		else if (q >= qp - cs.pw && q <= qp + cs.pw) cs.alpha[q] = ac;   /* pitch quefrencies: reset */
+		else cs.alpha[q] = cs.beta * cs.alpha[q] + (1.0 - cs.beta) * ac;
+		if (!cs.init) cs.lam[q] = cs.cep[q];
+		else cs.lam[q] = cs.alpha[q] * cs.lam[q] + (1.0 - cs.alpha[q]) * cs.cep[q];
+		cs.cep[q] = cs.lam[q];
+	}
+	cs.init = 1;
+	fftw_execute(cs.inv);
+	for (k = 0; k < m; k++) a->mask[k] = exp(cs.logg[k] / (double)n);   /* DCT-I pair scale = 2(N-1) = n */
+}
 
+/* fix_cep==2: same smoothing but cepstrum computed over the audio passband only (200-2900 Hz bins),
+   quefrency constants rescaled to that band's equivalent sample rate. */
+static cepst cb; static int cb_k0, cb_nb;
+static void cepb_smooth(EMNR a)
+{
+	int k, q;
+	double df = a->rate / a->fsize;
+	if (cb.n == 0)
+	{
+		cb_k0 = (int)(200.0 / df + 0.5); int k1 = (int)(2900.0 / df + 0.5); cb_nb = k1 - cb_k0 + 1;
+		cb.n = cb_nb;
+		cb.logg = (double*)fftw_malloc(cb_nb * sizeof(double)); cb.cep = (double*)fftw_malloc(cb_nb * sizeof(double));
+		cb.ly = (double*)fftw_malloc(cb_nb * sizeof(double)); cb.lyc = (double*)fftw_malloc(cb_nb * sizeof(double));
+		cb.lam = (double*)calloc(cb_nb, sizeof(double)); cb.alpha = (double*)calloc(cb_nb, sizeof(double));
+		cb.fwd = fftw_plan_r2r_1d(cb_nb, cb.logg, cb.cep, FFTW_REDFT00, FFTW_ESTIMATE);
+		cb.inv = fftw_plan_r2r_1d(cb_nb, cb.cep, cb.logg, FFTW_REDFT00, FFTW_ESTIMATE);
+		cb.ycep = fftw_plan_r2r_1d(cb_nb, cb.ly, cb.lyc, FFTW_REDFT00, FFTW_ESTIMATE);
+		double fs_eq = 2.0 * (cb_nb - 1) * df;
+		cb.scale = fs_eq / 8000.0;
+		double r = (a->incr / a->rate) / 0.016;
+		cb.a_hi = pow(0.97, r); cb.a_pitch = pow(0.4, r); cb.beta = pow(0.96, r);
+		cb.qlow = (int)(3.0 * cb.scale + 0.5); if (cb.qlow < 1) cb.qlow = 1;
+		cb.pw = (int)(1.0 * cb.scale + 0.5); if (cb.pw < 1) cb.pw = 1;
+		cb.qpmin = (int)(fs_eq / 400.0); cb.qpmax = (int)(fs_eq / 70.0);
+		cb.init = 0;
+	}
+	for (k = 0; k < cb_nb; k++) cb.logg[k] = log(max(a->mask[cb_k0 + k], fix_cep == 3 ? 1.0e-2 : 1.0e-6));
+	fftw_execute(cb.fwd);
+	for (k = 0; k < cb_nb; k++) cb.ly[k] = log(a->g.lambda_y[cb_k0 + k] + 1.0e-300);
+	fftw_execute(cb.ycep);
+	int qp = cb.qpmin; double best = -1e300;
+	for (q = cb.qpmin; q <= cb.qpmax && q < cb_nb; q++) if (cb.lyc[q] > best) { best = cb.lyc[q]; qp = q; }
+	for (q = 0; q < cb_nb; q++)
+	{
+		int inp = (q >= qp - cb.pw && q <= qp + cb.pw);
+		double ac = (q < cb.qlow) ? 0.0 : inp ? cb.a_pitch : cb.a_hi;
+		if (!cb.init || inp) cb.alpha[q] = ac; else cb.alpha[q] = cb.beta * cb.alpha[q] + (1.0 - cb.beta) * ac;
+		if (!cb.init) cb.lam[q] = cb.cep[q]; else cb.lam[q] = cb.alpha[q] * cb.lam[q] + (1.0 - cb.alpha[q]) * cb.cep[q];
+		cb.cep[q] = cb.lam[q];
+	}
+	cb.init = 1;
+	fftw_execute(cb.inv);
+	for (k = 0; k < cb_nb; k++) { a->mask[cb_k0 + k] = exp(cb.logg[k] / (2.0 * (cb_nb - 1))); if (fix_cep == 3 && a->mask[cb_k0 + k] > 1.0) a->mask[cb_k0 + k] = 1.0; }
+}
