+#ifndef KEEPSTATE_ONLY
+/* FIX(1): paired (shadow-chain) evaluation on identical, voiced-gated audio */
+#define PAIRED_VOICED_SECS 2.0
+#define PAIRED_WARM_SECS   0.2
+#define PAIRED_GATE_SECS   3.0
+#define PAIRED_GATE_FRAC   0.3
+
+static double fc_to_b0(PHROT a, double fc)
+{
+    double g = tan(PI * fc / (double)a->rate);
+    return (g - 1.0) / (g + 1.0);
+}
+
+static void paired_setup(PHROT a)
+{
+    int k;
+    a->sfc[0] = a->auto_fc - a->auto_step;
+    a->sfc[1] = a->auto_fc + a->auto_step;
+    for (k = 0; k < 2; k++)
+    {
+        if (a->sfc[k] < PHROT_FC_MIN) a->sfc[k] = PHROT_FC_MIN;
+        if (a->sfc[k] > PHROT_FC_MAX) a->sfc[k] = PHROT_FC_MAX;
+        a->sb0[k] = fc_to_b0(a, a->sfc[k]);
+        memcpy(a->sx0[k], a->x0, a->nstages * sizeof(double));
+        memcpy(a->sx1[k], a->x1, a->nstages * sizeof(double));
+        memcpy(a->sy0[k], a->y0, a->nstages * sizeof(double));
+        memcpy(a->sy1[k], a->y1, a->nstages * sizeof(double));
     }
+    for (k = 0; k < 3; k++)
+    {
+        a->sh_env_pos[k] = a->sh_env_pos[0];
+        a->sh_env_neg[k] = a->sh_env_neg[0];
+        a->sh_sum[k] = 0.0;
+    }
+    a->sh_nvoiced = 0;
+    a->sh_warm = (int)(PAIRED_WARM_SECS * a->rate / a->size) + 1;
 }
 
+/* runs BEFORE the live chain (in may alias out) */
+static void paired_pre(PHROT a, double *inpk, double spk[2][2])
+{
+    int i, n, k;
+    double x, y, p = 0.0;
+    for (i = 0; i < a->size; i++) { x = fabs(a->in[2 * i]); if (x > p) p = x; }
+    *inpk = p;
+    for (k = 0; k < 2; k++)
+    {
+        double b0 = a->sb0[k], bp = 0.0, bn = 0.0;
+        double *x0 = a->sx0[k], *x1 = a->sx1[k], *y0 = a->sy0[k], *y1 = a->sy1[k];
+        for (i = 0; i < a->size; i++)
+        {
+            x0[0] = a->in[2 * i];
+            for (n = 0; n < a->nstages; n++)
+            {
+                if (n > 0) x0[n] = y0[n - 1];
+                y0[n] = b0 * x0[n] + x1[n] - b0 * y1[n];
+                y1[n] = y0[n];
+                x1[n] = x0[n];
+            }
+            y = y0[a->nstages - 1];
+            if (y > bp) bp = y;
+            if (-y > bn) bn = -y;
+        }
+        spk[k][0] = bp; spk[k][1] = bn;
+    }
+}
+
+static void paired_post(PHROT a, double inpk, double spk[2][2])
+{
+    int i, j, best;
+    double bp = 0.0, bn = 0.0, pk[3][2], raw[3], m[3], cg, cp, cn, d;
+    if (a->auto_asym_best < 0.0)
+    {
+        a->auto_asym_best = 0.0;
+        a->auto_fc  = a->fc;
+        a->auto_step = PHROT_STEP_INIT;
+        a->auto_converged = 0;
+        paired_setup(a);
+        return;
+    }
+    for (i = 0; i < a->size; i++)
+    {
+        double y = a->out[2 * i];
+        if (y > bp) bp = y;
+        if (-y > bn) bn = -y;
+    }
+    pk[0][0] = bp; pk[0][1] = bn;
+    pk[1][0] = spk[0][0]; pk[1][1] = spk[0][1];
+    pk[2][0] = spk[1][0]; pk[2][1] = spk[1][1];
+    for (j = 0; j < 3; j++)
+    {
+        cp = (pk[j][0] > a->sh_env_pos[j]) ? a->coeff_attack : a->coeff_decay;
+        cn = (pk[j][1] > a->sh_env_neg[j]) ? a->coeff_attack : a->coeff_decay;
+        a->sh_env_pos[j] = cp * a->sh_env_pos[j] + (1.0 - cp) * pk[j][0];
+        a->sh_env_neg[j] = cn * a->sh_env_neg[j] + (1.0 - cn) * pk[j][1];
+        d = a->sh_env_pos[j] + a->sh_env_neg[j];
+        raw[j] = (d > 1e-20) ? fabs(a->sh_env_pos[j] - a->sh_env_neg[j]) / d : 0.0;
+    }
+    cg = exp(-(double)a->size / (double)a->rate / PAIRED_GATE_SECS);
+    a->gate_peak = (inpk > a->gate_peak) ? inpk : cg * a->gate_peak;
+    if (a->sh_warm > 0) { a->sh_warm--; return; }
+    if (!(inpk > PAIRED_GATE_FRAC * a->gate_peak && inpk > 1e-3)) return;
+    for (j = 0; j < 3; j++) a->sh_sum[j] += raw[j];
+    a->sh_nvoiced++;
+    if ((double)a->sh_nvoiced * a->size < PAIRED_VOICED_SECS * a->rate) return;
+    for (j = 0; j < 3; j++) m[j] = a->sh_sum[j] / a->sh_nvoiced;
+    best = (m[1] < m[2]) ? 1 : 2;
+    if (a->sfc[best - 1] != a->auto_fc && m[best] < m[0] * (1.0 - PHROT_IMPROVE_THRESH))
+    {
+        int k = best - 1;
+        a->auto_fc = a->sfc[k];
+        a->fc = a->sfc[k];
+#ifndef SWITCH_MODE
+#define SWITCH_MODE 2
+#endif
+#if SWITCH_MODE == 2
+        /* crossfade: the old live chain keeps running as the fade-out chain */
+        a->fb0 = a->b0;
+        memcpy(a->fx0, a->x0, a->nstages * sizeof(double));
+        memcpy(a->fx1, a->x1, a->nstages * sizeof(double));
+        memcpy(a->fy0, a->y0, a->nstages * sizeof(double));
+        memcpy(a->fy1, a->y1, a->nstages * sizeof(double));
+        a->fade_n = a->fade_len;
+#endif
+        a->b0 = a->sb0[k]; a->b1 = 1.0; a->a1 = a->b0;
+#if SWITCH_MODE != 1
+        /* adopt the shadow chain's state, which ran on the same input */
+        memcpy(a->x0, a->sx0[k], a->nstages * sizeof(double));
+        memcpy(a->x1, a->sx1[k], a->nstages * sizeof(double));
+        memcpy(a->y0, a->sy0[k], a->nstages * sizeof(double));
+        memcpy(a->y1, a->sy1[k], a->nstages * sizeof(double));
+#endif
+        a->sh_env_pos[0] = a->sh_env_pos[best];
+        a->sh_env_neg[0] = a->sh_env_neg[best];
+        a->auto_asym_best = m[best];
+    }
+    else
+    {
+        a->auto_step *= PHROT_STEP_SHRINK;
+        if (a->auto_step <= PHROT_STEP_MIN) { a->auto_step = PHROT_STEP_MIN; a->auto_converged = 1; return; }
+    }
+    paired_setup(a);
+}
