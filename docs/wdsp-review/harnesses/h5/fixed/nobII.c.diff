+static double ar_fill[2*80000]; static int ar_fpos;
+static double ar_l[2*AR_CTX], ar_r[2*AR_CTX];
+static void mode5_prepare(NOB a)
+{
+	int G = a->adv_slew_count + a->adv_count + a->blank_count + a->hang_slew_count;
+	int g0 = a->out_idx + 1, n, idx;
+	int avail_r;
+	ar_fpos = 0;
+	if (G > (int)(AR_MAXGAP_TIME * a->samplerate)) { memset(ar_fill, 0, 2*G*sizeof(double)); return; }
+	/* left context: walk back from out_idx while unflagged */
+	for (n = 0, idx = a->out_idx; n < AR_CTX; n++) { if (a->imp[idx]) break; if (--idx < 0) idx += a->dline_size; }
+	int nl = n; idx = a->out_idx - nl + 1; if (idx < 0) idx += a->dline_size;
+	for (n = 0; n < nl; n++) { ar_l[2*n] = a->dline[2*idx]; ar_l[2*n+1] = a->dline[2*idx+1]; if (++idx >= a->dline_size) idx -= a->dline_size; }
+	/* right context: from g0+G forward while unflagged and already received (<= in_idx) */
+	avail_r = a->in_idx - (g0 + G) + 1; while (avail_r < 0) avail_r += a->dline_size; if (avail_r > a->dline_size/2) avail_r = 0;
+	idx = (g0 + G) % a->dline_size;
+	for (n = 0; n < AR_CTX && n < avail_r; n++) { if (a->imp[idx]) break; ar_r[2*n] = a->dline[2*idx]; ar_r[2*n+1] = a->dline[2*idx+1]; if (++idx >= a->dline_size) idx -= a->dline_size; }
+	if (!ar_gap_fill(ar_l, nl, ar_r, n, G, AR_ORDER, ar_fill)) memset(ar_fill, 0, 2*G*sizeof(double));
+}
