+#include <float.h>
+/* ---- harness fix: proposal (a)/(b)/(c) and skeptic clamp, selected by FIXMODE bits ----
+   bit0 (1): (a)+(c) floors tied to long-term mean of lambda_y, robust ratios
+   bit1 (2): (b) hold estimator state on digital silence
+   bit2 (4): clamp invQeq to >= 0 (varHat negative-residue guard)                     */
+#ifndef FIXMODE
+#define FIXMODE 7
+#endif
+static double fx_ltmean = 0.0;
+static int fx_init = 0;
+#define FX_TINY ((double)FLT_MIN)
+static double fx_floor(void) { return 1.0e-10 * fx_ltmean + FX_TINY; }
+/* returns 1 if the frame is digital silence (estimator should hold) */
+static int fx_update_and_check(EMNR a)
+{
+	int k; double m = 0.0;
+	for (k = 0; k < a->msize; k++) m += a->g.lambda_y[k];
+	m /= (double)a->msize;
+	double tau = 10.0, al = exp(-a->incr / a->rate / tau);
+	if (!fx_init) { fx_ltmean = m; fx_init = 1; }
+	int silent = (m <= 1.0e-10 * fx_ltmean + FX_TINY);
+	if (!silent) fx_ltmean = al * fx_ltmean + (1.0 - al) * m;
+	return silent;
+}
+static void fx_floor_lambda_y(EMNR a)
+{
+	int k; double fl = fx_floor();
+	for (k = 0; k < a->msize; k++) if (a->g.lambda_y[k] < fl) a->g.lambda_y[k] = fl;
 }
 
