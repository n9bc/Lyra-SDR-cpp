+			double f = fincr * (double)i;
+			double hw = 24.7 * (4.37 * f / 1000.0 + 1.0) / 6.0;	// half of 1/3 ERB
+			int lo = (int)ceil ((f - hw) / fincr);
+			int hi = (int)floor ((f + hw) / fincr);
+			if (lo < 0) lo = 0;
+			if (hi > a->msize - 1) hi = a->msize - 1;
+			if (lo > i) lo = i;
+			if (hi < i) hi = i;
+			a->elo[i] = lo;
+			a->ehi[i] = hi;
+		}
+	}
 }
 
