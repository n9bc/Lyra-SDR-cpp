+static void acquire_amd (AMD a)
+{
+	int N = a->acq_n, n, k, kbest = 0;
+	fftw_complex *in = (fftw_complex *)a->acq_in, *out = (fftw_complex *)a->acq_out;
+	double pbest = -1.0, psum = 0.0; int pcnt = 0;
+	for (n = 0; n < N; n++)
+	{
+		int r = (a->acq_wp + n) % N;
+		in[n][0] = a->acq_ring[2 * r + 0] * a->acq_win[n];
+		in[n][1] = a->acq_ring[2 * r + 1] * a->acq_win[n];
+	}
+	fftw_execute((fftw_plan)a->acq_plan);
+	int kmin = (int)ceil (a->fmin * N / a->sample_rate);
+	int kmax = (int)floor(a->fmax * N / a->sample_rate);
+	for (k = kmin; k <= kmax; k++)
+	{
+		int kk = (k + N) % N;
+		double p = out[kk][0] * out[kk][0] + out[kk][1] * out[kk][1];
+		psum += p; pcnt++;
+		if (p > pbest) { pbest = p; kbest = k; }
+	}
+	// require a line at least 10 dB above the mean in the search band
+	if (pcnt == 0 || pbest < 10.0 * psum / pcnt) return;
+	double lm = log(1e-300 + out[(kbest - 1 + N) % N][0] * out[(kbest - 1 + N) % N][0] + out[(kbest - 1 + N) % N][1] * out[(kbest - 1 + N) % N][1]);
+	double l0 = log(1e-300 + pbest);
+	double lp = log(1e-300 + out[(kbest + 1 + N) % N][0] * out[(kbest + 1 + N) % N][0] + out[(kbest + 1 + N) % N][1] * out[(kbest + 1 + N) % N][1]);
+	double den = lm - 2.0 * l0 + lp, delta = 0.0;
+	if (den < 0.0) delta = 0.5 * (lm - lp) / den;
+	double f = (kbest + delta) * a->sample_rate / N;
+	a->omega = TWOPI * f / a->sample_rate;
+	if (a->omega < a->omega_min) a->omega = a->omega_min;
+	if (a->omega > a->omega_max) a->omega = a->omega_max;
+	a->fil_out = a->omega;
+	a->acq_count++;
 }
 
