+// FIX: recompute coefficients in place; keep state, count, avsig, vox_count and the audio ring
+void recalc_dexp_coefs (DEXP a)
+{
+	int na = (int)(a->tattack * a->rate);
+	int nd = (int)(a->tdecay * a->rate);
+	a->avm = exp(-1.0 / (a->rate * a->dettau));
+	a->onem_avm = 1.0 - a->avm;
+	if (na != a->nattack)
+	{
+		_aligned_free (a->cattack);
+		a->cattack = (double *)malloc0((na + 1) * sizeof(double));
+		if (a->state == DEXP_ATTACK_FIX)
+			a->count = (int)((double)a->count * (double)na / (double)(a->nattack > 0 ? a->nattack : 1));
+		a->nattack = na;
+	}
+	if (nd != a->ndecay)
+	{
+		_aligned_free (a->cdecay);
+		a->cdecay = (double *)malloc0((nd + 1) * sizeof(double));
+		if (a->state == DEXP_DECAY_FIX)
+			a->count = (int)((double)a->count * (double)nd / (double)(a->ndecay > 0 ? a->ndecay : 1));
+		a->ndecay = nd;
+	}
+	a->low_gain = 1.0 / a->exp_ratio;
+	calc_slews(a);
+	a->hold_thresh = a->hysteresis_ratio * a->attack_thresh;
+	a->nhold = (int)(a->thold * a->rate);
+	if (a->state == DEXP_HOLD_FIX && a->count > a->nhold) a->count = a->nhold;
+}
+
 void decalc_dexp (DEXP a)
 {
