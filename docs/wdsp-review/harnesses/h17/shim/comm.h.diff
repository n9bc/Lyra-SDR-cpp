+static inline void* malloc0(int size)
+{
+	void* p = NULL;
+	size_t sz = ((size_t)size + 15) & ~(size_t)15;
+	if (sz == 0) sz = 16;
+	if (posix_memalign(&p, 16, sz) != 0) return NULL;
+	memset(p, 0, sz);
+	return p;
+}
